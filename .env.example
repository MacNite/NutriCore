# ---------------------------------------------------------------------------
# NutriCore configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Public URL of the application. Cookies are marked Secure when this is https.
APP_URL=http://localhost:3000
APP_PORT=3000

# Prebuilt image published by the "Publish image" workflow. Pin a version tag
# for a reproducible deployment, e.g. ghcr.io/macnite/nutricore:v0.1.0
# Ignored when you build locally with `docker compose up -d --build`.
APP_IMAGE=ghcr.io/macnite/nutricore:latest

# Required. At least 32 characters. Generate with:  openssl rand -base64 48
APP_SECRET=replace-with-at-least-32-random-characters

# --- Database --------------------------------------------------------------
# Compose builds DATABASE_URL from the values below; set it directly only when
# running the app outside compose.
POSTGRES_DB=nutricore
POSTGRES_USER=nutricore
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://nutricore:change-me@db:5432/nutricore?schema=public

# Absolute paths on TrueNAS, e.g. /mnt/tank/apps/nutricore/postgres
POSTGRES_DATA_PATH=./data/postgres
BACKUP_PATH=./backups

# --- Localisation ----------------------------------------------------------
# Default for new accounts and signed-out visitors: de or en.
DEFAULT_LOCALE=de

# Maximum size of an uploaded meal or recipe image, in whole MiB (1-50).
# The default is 5. Next.js has a separate bounded request ceiling above the
# largest permitted value so this setting remains configurable at runtime.
IMAGE_UPLOAD_MAX_MB=5

# --- Open Food Facts -------------------------------------------------------
OPENFOODFACTS_ENABLED=true
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
# Open Food Facts blocks or throttles callers it cannot identify, which shows
# up as an unexplained 403 in the food search. Replace the address below with a
# real one you read: an app name plus a contact is what the service asks for.
# The diagnostics page reports whether this value is still the placeholder.
OPENFOODFACTS_USER_AGENT=NutriCore/0.1 (admin@example.invalid)

# Text search runs against Search-a-licious, the Elasticsearch service that
# replaces the legacy /cgi/search.pl endpoint - which answers 503 for minutes
# at a time under load. Barcode lookups always use OPENFOODFACTS_BASE_URL.
# Set the backend to `legacy` to pin the old endpoint instead; the default
# already falls back to it when the search service is unreachable.
OPENFOODFACTS_SEARCH_URL=https://search.openfoodfacts.org
OPENFOODFACTS_SEARCH_BACKEND=search-a-licious

# --- Bundeslebensmittelschlüssel (BLS) 4.0 ---------------------------------
# The German national nutrient database, bundled with the application: 7,140
# generic foods with German and English names, imported into PostgreSQL and
# answered without any network request. On unless you turn it off.
#
# Import it once per deployment (idempotent, so it is safe to repeat):
#   docker compose exec app npm run db:import:foods
# The worker also imports it in the background on startup, and Admin ->
# Food databases has a button. Nothing has to be downloaded at runtime.
BLS_ENABLED=true

# --- USDA FoodData Central -------------------------------------------------
# Also bundled: the Foundation Foods and SR Legacy releases (8,156 generic
# foods) are imported by the same command as BLS. This is the primary generic
# source for English-locale users.
#
# NOTE: this defaults to `true` now that the data ships with the application.
# It used to default to `false`, when USDA was only reachable over the API.
USDA_ENABLED=true
# Optional, and only needed to search *beyond* the bundled releases - newer
# Foundation records, Survey (FNDDS) and Branded foods. Free key from
# https://fdc.nal.usda.gov/api-key-signup. Without it the bundled data is
# still searched; only the live API is skipped. Never sent to the browser.
USDA_API_KEY=

# --- FatSecret (optional) --------------------------------------------------
# A verified external fallback, asked only after the open databases above have
# been tried. Entirely optional: leave FATSECRET_ENABLED=false and NutriCore
# behaves exactly as it does without the provider.
#
# Two things to know before enabling it:
#  * The Platform API only answers requests from IP addresses registered with
#    your FatSecret account. A self-hosted instance on a changing address will
#    be refused; the diagnostics page reports this as a configuration problem.
#  * Its terms do not allow building a copy of their database, so NutriCore
#    caches FatSecret content for 24 hours and then prunes it, instead of
#    storing it permanently the way it stores BLS, USDA and Open Food Facts.
FATSECRET_ENABLED=false
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Premier-plan features. Leave empty on a basic plan: NutriCore skips the
# capability rather than silently returning a different region's data.
FATSECRET_REGION=
FATSECRET_LANGUAGE=

# --- AI --------------------------------------------------------------------
# Ollama runs outside this compose stack; point at it by hostname, not by IP.
# The model must already be pulled on the Ollama host:  ollama pull qwen3.5:4b
# NutriCore never downloads a model itself.
#
# AI_BASE_URL and AI_MODEL are the only two the app needs: both the AI client
# and Settings -> Diagnostics read them, so the page can no longer report a
# different instance than the one actually being called. OLLAMA_BASE_URL and
# OLLAMA_MODEL still work as a fallback for an existing deployment, but they
# are superseded - prefer the two below.
AI_ENABLED=true
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen3.5:4b
# Optional fallback is reserved for low-confidence/invalid structured output.
AI_FALLBACK_MODEL=
AI_CONFIDENCE_THRESHOLD=medium
# Maximum duration of one model generation. Increase for slower local models.
# The request streams, so this is the only deadline that applies; with a
# non-streaming request Node's own 300 second headers timeout silently won.
OLLAMA_TIMEOUT_SECONDS=600
# Hard ceiling on generated tokens (Ollama's num_predict). A JSON schema that
# permits an open-ended object or a long array otherwise lets a model generate
# until it hits the timeout instead of returning anything. Raise it only if
# whole answers are being reported as cut off in the admin panel.
#
# NutriCore asks for structured JSON with `think: false`, because a reasoning
# model left to think spends this budget on its chain of thought and can be
# stopped before it ever writes the JSON. If the panel still reports answers cut
# off "with N characters of reasoning", the model is ignoring that flag: either
# raise this value or configure a non-reasoning model.
OLLAMA_MAX_OUTPUT_TOKENS=2048

# --- Web research ----------------------------------------------------------
# Only controls whether an AI research run may fetch source URLs from the open
# web. AI food search itself needs AI_ENABLED only and works without this.
RESEARCH_ENABLED=false
# Reserved for future search-provider integrations. Leave empty when using
# SearXNG; SEARXNG_URL below selects the currently implemented provider.
RESEARCH_PROVIDER=
OLLAMA_WEB_API_KEY=
SEARCH_API_BASE_URL=
SEARCH_API_KEY=

# SearXNG supplies source discovery only; the LLM is never authoritative for nutrients.
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT_MS=5000

# --- SMTP mailer ----------------------------------------------------------
# When SMTP_HOST is set these values take precedence over Administrator Panel
# settings. Remove SMTP_HOST to manage mail delivery in the panel instead.
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NutriCore

# Single-use onboarding links are stored as hashes and expire after this interval.
# Who may create an account without an invitation.
#   bootstrap (default) - sign-up works until the first account exists, and that
#                         account becomes the administrator; then it closes
#   open                - anyone who can reach the page may register
#   disabled            - no self-registration at all, including the first
REGISTRATION_MODE=bootstrap

# How many reverse proxies sit in front of this deployment. 0 (the default)
# means X-Forwarded-For is not trusted at all, which is correct for the stock
# Compose stack that publishes its own port. Set it to the number of proxies
# that append to the header, and make sure the outermost one STRIPS any
# inbound X-Forwarded-For - otherwise a client can forge its own rate-limit
# bucket and sign-in throttling stops working.
TRUSTED_PROXY_HOPS=0

INVITATION_EXPIRY_HOURS=48
# Worker database polling interval.
AI_WORKER_POLL_MS=2000

# --- Operations ------------------------------------------------------------
LOG_LEVEL=info
# Scales authentication rate limits. Used only by the E2E suite; leave unset.
# RATE_LIMIT_MULTIPLIER=1
