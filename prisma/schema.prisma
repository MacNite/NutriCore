generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  de
  en
}

enum BasisUnit {
  G
  ML
}

/// Where a food's numbers came from. Each value is a distinct data source with
/// its own trust, licensing and persistence rules - never a stand-in for
/// another, so provenance survives in the UI and in an export.
enum SourceType {
  OPEN_FOOD_FACTS
  USDA
  /// Bundeslebensmittelschlüssel: bundled with the application, never fetched.
  BLS
  FATSECRET
  USER
  RECIPE
  AI_RESEARCH
  IMPORTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

enum FoodType {
  PACKAGED
  GENERIC
  RAW
  COOKED
  BEVERAGE
  RECIPE
}

/// An AI-generated recipe is stored as a DRAFT: it is listed with the user's
/// recipes but has no Food entry, so nothing can be logged from it until the
/// user has confirmed it.
enum RecipeStatus {
  DRAFT
  ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
  CUSTOM
}

enum BiologicalSex {
  MALE
  FEMALE
  UNSPECIFIED
}

/// Where a recorded body value came from. Shown as a text badge, never as colour alone.
enum MeasurementSource {
  MANUAL
  BIA
  OTHER_DEVICE
  /// Estimated from a guided two-view photo capture. Never a measurement.
  OPTICAL_SCAN
}

/// How far a body scan has got. Every path to ACCEPTED runs through
/// AWAITING_REVIEW: an estimate becomes a recorded measurement only because
/// someone looked at it and said so.
enum BodyScanState {
  QUEUED
  PROCESSING
  AWAITING_REVIEW
  ACCEPTED
  REJECTED
  FAILED
  EXPIRED
  /// Nothing ever picked the scan up. Distinct from EXPIRED, which is a sweeper
  /// clearing images a worker had not got to: this is the app itself declaring
  /// a scan dead because no worker moved it on at all, and it is the state that
  /// stops a stopped worker showing "processing" for ever.
  TIMED_OUT
}

/// What the reviewer did with one estimated value.
enum BodyScanDecision {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
}

/// A cosmetic build for the drawn figure. Chosen by the user, never inferred
/// from their measurements and never used in any calculation: somatotypes are
/// not a diagnosis and carry no predictive meaning here.
enum BodyType {
  ECTOMORPH
  MESOMORPH
  ENDOMORPH
}

/// How the drawn figure is presented. Separate from `biologicalSex`, which is
/// a clinical input to the energy and body-fat formulas.
enum BodyFigure {
  NEUTRAL
  MASCULINE
  FEMININE
}

/// How the body-shape panel draws that figure: as a silhouette with tinted
/// change bands, or as a measure figure with a caliper across every level a
/// tape measure was put around. A display choice over the same numbers.
enum BodyShapeStyle {
  SILHOUETTE
  MEASURE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ResearchStatus {
  REQUESTED
  SEARCHING
  SOURCES_FOUND
  EXTRACTING
  MATCHING_INGREDIENTS
  CALCULATING
  AWAITING_CONFIRMATION
  ACCEPTED
  REJECTED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AiApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  role               UserRole @default(USER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)

  profile           UserProfile?
  sessions          Session[]
  targets           NutritionTarget[]
  weights           WeightEntry[]
  bodyMeasurements  BodyMeasurement[]
  foods             Food[]
  recipes           Recipe[]
  diaryDays         DiaryDay[]
  favorites         Favorite[]
  usage             FoodUsageStats[]
  research          ResearchJob[]
  invitationsSent   UserInvitation[]    @relation("InvitationSender")
  aiJobs            AiJob[]
  aiIngestionInputs AiIngestionInput[]
  activityEntries   ActivityEntry[]
  bodyScans         BodyScan[]
  publications      RecipePublication[]
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  name        String?
  role        UserRole  @default(USER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// Singleton SMTP configuration (the row with id = "default"). The password
/// is encrypted with APP_SECRET before it reaches the database.
model MailSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String?
  port              Int      @default(587)
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromEmail         String?
  fromName          String?
  updatedAt         DateTime @updatedAt
}

model AiIngestionInput {
  id              String    @id @default(cuid())
  userId          String
  intent          String
  text            String
  sourceUrl       String?
  /**
   * Transient worker handoff; cleared after extraction or terminal cleanup.
   */
  imageMime       String?
  imageData       Bytes?
  imageExpiresAt  DateTime?
  meal            MealType?
  diaryDate       DateTime? @db.Date
  /**
   * Number of portions described by the submitted text, URL, or photo.
   */
  servings        Decimal   @default(1) @db.Decimal(8, 2)
  logAfterConfirm Boolean   @default(false)
  draft           Json?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiJobs          AiJob[]
  recipes         Recipe[]

  @@index([userId, createdAt])
  @@index([imageExpiresAt])
}

model AiJob {
  id               String            @id @default(cuid())
  userId           String
  entityType       String
  entityId         String
  ingestionInputId String?
  status           AiJobStatus       @default(QUEUED)
  /**
   * Higher runs first, in the bands `jobPriority` writes: 20 recipe generation,
   * 10 everything else a user is waiting for, 0 background enrichment. A
   * "Backfill missing nutrition" sweep can queue hundreds of jobs at once, and a
   * strictly chronological queue put every quick meal behind all of them - hours
   * of waiting for a request the user is watching.
   */
  priority         Int               @default(10)
  retryCount       Int               @default(0)
  maxRetries       Int               @default(2)
  model            String?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  /**
   * Machine-readable cause of the last failure; see `AiFailureKind`.
   */
  failureKind      String?
  /**
   * Longest useful diagnostic detail, e.g. the underlying fetch/undici cause.
   */
  errorDetail      String?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingestionInput   AiIngestionInput? @relation(fields: [ingestionInputId], references: [id], onDelete: Cascade)
  proposal         AiProposal?
  attempts         AiJobAttempt[]

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
}

/**
 * One recorded attempt at a job. `AiJob.errorMessage` only ever holds the most
 * recent failure, which hides the pattern that actually explains a job: three
 * different reasons across three retries mean something else than the same
 * reason three times. Kept per attempt so the admin page can show that pattern.
 */
model AiJobAttempt {
  id         String   @id @default(cuid())
  jobId      String
  /**
   * Value of `AiJob.retryCount` when the attempt ran; 0 is the first try.
   */
  attempt    Int
  kind       String
  message    String
  detail     String?
  model      String?
  durationMs Int?
  createdAt  DateTime @default(now())
  job        AiJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attempt])
}

model AiProposal {
  id             String           @id @default(cuid())
  jobId          String           @unique
  approvalStatus AiApprovalStatus @default(PENDING)
  confidence     String
  proposed       Json
  accepted       Json?
  provenance     Json
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  job            AiJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  displayName         String
  language            Locale          @default(de)
  unitPreference      String          @default("metric")
  birthDate           DateTime?       @db.Date
  heightCm            Decimal?        @db.Decimal(6, 2)
  weightKg            Decimal?        @db.Decimal(6, 2)
  biologicalSex       BiologicalSex   @default(UNSPECIFIED)
  activityLevel       ActivityLevel   @default(MODERATE)
  goal                Goal            @default(MAINTAIN)
  targetWeightKg      Decimal?        @db.Decimal(6, 2)
  isPregnant          Boolean         @default(false)
  isBreastfeeding     Boolean         @default(false)
  aiEnabled           Boolean         @default(true)
  researchEnabled     Boolean         @default(false)
  /**
   * Whether nutrition the AI backfill finds may be written straight to the
   * food, or has to be approved first. Off by default: enrichment is the one
   * AI path that used to write without review, and "human approves" is the
   * rule everywhere else in the app. A single-user instance that trusts the
   * backfill can turn it back on and keep the old behaviour.
   */
  autoApplyEnrichment Boolean         @default(false)
  /**
   * Apply an AI meal proposal to the diary without opening the review screen.
   * Defaults on because a queued meal that is never reviewed is a meal that was
   * never logged, and the review screen is only reachable straight after
   * submitting. Everything it logs is still recorded on the proposal and every
   * value still carries its provenance; turn it off to approve each one by hand.
   */
  autoApproveAi       Boolean         @default(true)
  theme               String          @default("system")
  /// Appearance of the body-progress figure. Null until the user picks one.
  bodyType            BodyType?
  bodyFigure          BodyFigure?
  /// How the shape panel draws it. Null until the user picks one.
  bodyShapeStyle      BodyShapeStyle?
  /**
   * Which body-progress visualisations the reader wants. Both default on: the
   * card is the point of the progress page, and anyone who never opens their
   * settings should still see it. Turning one off hides the visualisation only
   * - the underlying measurements stay recorded, exported and editable.
   */
  showBodyComposition Boolean         @default(true)
  showBodyShape       Boolean         @default(true)
  /// Add exercise calories recorded for a date to that date's energy allowance.
  addActivityCalories Boolean         @default(true)
  onboardedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Every component of the calorie target is stored, never only the final number.
model NutritionTarget {
  id                 String   @id @default(cuid())
  userId             String
  validFrom          DateTime @default(now())
  bmrKcal            Decimal? @db.Decimal(8, 2)
  activityMultiplier Decimal? @db.Decimal(4, 2)
  tdeeKcal           Decimal? @db.Decimal(8, 2)
  goalAdjustmentKcal Decimal? @db.Decimal(8, 2)
  calculatedKcal     Decimal? @db.Decimal(8, 2)
  overrideKcal       Decimal? @db.Decimal(8, 2)
  proteinG           Decimal? @db.Decimal(8, 2)
  carbohydrateG      Decimal? @db.Decimal(8, 2)
  fatG               Decimal? @db.Decimal(8, 2)
  /// User-entered macro and micronutrient goals, keyed by the nutrient catalogue key.
  manualNutrients    Json?
  eligible           Boolean  @default(true)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validFrom])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Decimal  @db.Decimal(6, 2)
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/// One measuring-tape session. Weight is deliberately absent: it lives in
/// `WeightEntry` so the weight chart, the goal line and body progress can never
/// disagree about what someone weighed on a given day.
///
/// Every value is optional. A session where only the waist was measured is a
/// real session, and storing zero for the rest would be a lie about it.
model BodyMeasurement {
  id                String             @id @default(cuid())
  userId            String
  date              DateTime           @db.Date
  neckCm            Decimal?           @db.Decimal(5, 1)
  chestCm           Decimal?           @db.Decimal(5, 1)
  waistCm           Decimal?           @db.Decimal(5, 1)
  hipCm             Decimal?           @db.Decimal(5, 1)
  upperArmLeftCm    Decimal?           @db.Decimal(5, 1)
  upperArmRightCm   Decimal?           @db.Decimal(5, 1)
  thighLeftCm       Decimal?           @db.Decimal(5, 1)
  thighRightCm      Decimal?           @db.Decimal(5, 1)
  calfLeftCm        Decimal?           @db.Decimal(5, 1)
  calfRightCm       Decimal?           @db.Decimal(5, 1)
  bodyFatPct        Decimal?           @db.Decimal(4, 1)
  muscleKg          Decimal?           @db.Decimal(5, 1)
  bodyWaterPct      Decimal?           @db.Decimal(4, 1)
  boneKg            Decimal?           @db.Decimal(4, 1)
  /// Where the composition values came from. Null when none were recorded.
  compositionSource MeasurementSource?
  /**
   * Per-value provenance, as `{ "waistCm": "OPTICAL_SCAN" }`. A field absent
   * from the map was entered by hand, which is what every row recorded before
   * scanning existed was: null therefore keeps meaning MANUAL and no backfill
   * is needed. `compositionSource` still describes the composition block, so a
   * session that mixes a scanned waist with a smart-scale body fat can say so
   * without either claim overwriting the other.
   */
  valueSources      Json?
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/**
 * One guided two-view body scan.
 * The images are a transient worker handoff and nothing else: they are written
 * here so the capture can outlive the request that submitted it, read exactly
 * once, and cleared in the same transaction that stores the estimates. They are
 * never re-served to the browser, never logged, and a sweeper clears whatever a
 * crash left behind. `imagesExpireAt` is the deadline that sweeper enforces, so
 * an abandoned capture disappears without anyone deciding to delete it.
 * Height and weight are snapshotted rather than read back from the profile:
 * they are inputs to the estimate, and an estimate has to stay explainable by
 * the numbers it was actually computed from.
 */
model BodyScan {
  id             String        @id @default(cuid())
  userId         String
  /// The day the scan is for, matching the check-in it can be merged into.
  date           DateTime      @db.Date
  state          BodyScanState @default(QUEUED)
  /// Stature the estimate was scaled by. Without it there is no scale at all.
  heightCm       Decimal       @db.Decimal(5, 1)
  /// Closest same-day weight, recorded for provenance. Not used for scaling.
  weightKg       Decimal?      @db.Decimal(6, 2)
  /// Which version of the consent copy the user agreed to for this scan.
  consentVersion String
  frontMime      String?
  frontData      Bytes?
  sideMime       String?
  sideData       Bytes?
  imagesExpireAt DateTime?
  /// Which estimator produced the result, so a later one can be told apart.
  provider       String?
  processorModel String?
  version        String?
  /// Whether the capture passed its quality checks, and the reasons if not.
  accepted       Boolean       @default(false)
  qualityReasons Json?
  /// Machine-readable cause of a FAILED scan.
  failureKind    String?
  createdAt      DateTime      @default(now())
  processedAt    DateTime?
  reviewedAt     DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimates BodyScanEstimate[]

  @@index([userId, createdAt])
  @@index([imagesExpireAt])
}

/**
 * One estimated value from a scan, kept whatever the reviewer decided.
 * The estimate and the decision are separate columns because an edited value
 * has to keep both: what the estimator claimed is the audit record, and what
 * the user corrected it to is the measurement. Overwriting one with the other
 * would make a correction indistinguishable from a good estimate.
 */
model BodyScanEstimate {
  id         String           @id @default(cuid())
  scanId     String
  /// A `BodyMeasurement` circumference field name, e.g. `waistCm`.
  metricKey  String
  valueCm    Decimal          @db.Decimal(5, 1)
  /// Interval the estimator is prepared to stand behind, never a bare decimal.
  lowerCm    Decimal          @db.Decimal(5, 1)
  upperCm    Decimal          @db.Decimal(5, 1)
  decision   BodyScanDecision @default(PENDING)
  /// What the user accepted, when they edited the estimate rather than taking it.
  acceptedCm Decimal?         @db.Decimal(5, 1)
  createdAt  DateTime         @default(now())

  scan BodyScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, metricKey])
  @@index([scanId])
}

/// Exercise energy is snapshotted so catalogue and weight changes never rewrite history.
model ActivityEntry {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @db.Date
  activityKey        String
  intensityKey       String
  durationMinutes    Int
  metSnapshot        Decimal  @db.Decimal(5, 2)
  weightKgSnapshot   Decimal? @db.Decimal(6, 2)
  activeKcalSnapshot Decimal? @db.Decimal(10, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Canonical nutrient catalogue. New nutrients are rows, not migrations.
model NutrientDefinition {
  id            String @id @default(cuid())
  key           String @unique
  nameDe        String
  nameEn        String
  canonicalUnit String
  category      String @default("micro")
  sortOrder     Int    @default(1000)

  values FoodNutrient[]
}

model Food {
  id               String     @id @default(cuid())
  ownerId          String?
  name             String
  normalizedName   String
  locale           Locale?
  brand            String?
  barcode          String?
  foodType         FoodType   @default(GENERIC)
  sourceType       SourceType
  externalProvider String?
  externalId       String?
  basisAmount      Decimal    @default(100) @db.Decimal(10, 3)
  basisUnit        BasisUnit
  servingSize      Decimal?   @db.Decimal(10, 3)
  servingUnit      String?
  densityGPerMl    Decimal?   @db.Decimal(10, 5)
  dataConfidence   Decimal?   @db.Decimal(4, 3)
  isEstimated      Boolean    @default(false)
  rawState         String?
  /**
   * When enrichment last ran for this food, whatever it found. Without it the
   * "Backfill missing nutrition" sweep re-queued every food whose gaps could
   * not be filled, on every click, for ever.
   */
  enrichedAt       DateTime?
  /**
   * When this row may no longer be kept, for a provider whose terms allow
   * caching but not permanent storage (see `PersistencePolicy` in
   * src/providers/food.ts). NULL means the food is permanent - which is the
   * case for everything a user created, every recipe, and every bundled
   * database such as BLS or USDA.
   * A diary entry freezes its own nutrition and provenance and holds the food
   * with `onDelete: SetNull`, so pruning an expired row cannot rewrite or
   * break a logged meal.
   */
  cacheExpiresAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  owner               User?                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  aliases             FoodAlias[]
  translations        FoodTranslation[]
  servings            FoodServing[]
  sources             FoodSource[]
  nutrients           FoodNutrient[]
  recipeIngredients   RecipeIngredient[]
  diaryEntries        DiaryEntry[]
  favorites           Favorite[]
  usage               FoodUsageStats[]
  enrichmentProposals EnrichmentProposal[]

  @@unique([externalProvider, externalId])
  @@index([barcode])
  @@index([normalizedName])
  @@index([ownerId])
  @@index([sourceType])
  @@index([cacheExpiresAt])
}

/// The same food's name in another language.
///
/// A bundled reference database supplies its own official translations - BLS
/// 4.0 carries a German and an English name for all 7,140 foods - and a
/// German-speaking user should read the German one while an English-speaking
/// user reads the English one. `Food.name` stays the source's primary name;
/// this table carries the rest, so adding a third language is a row and not a
/// migration. A branded product is never translated: only sources that publish
/// official names get entries here.
model FoodTranslation {
  foodId         String
  locale         Locale
  name           String
  normalizedName String

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([foodId, locale])
  @@index([normalizedName])
}

model FoodAlias {
  id     String  @id @default(cuid())
  foodId String
  name   String
  locale Locale?
  food   Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
  @@index([name])
}

/// A named portion always carries a resolved gram or millilitre quantity.
model FoodServing {
  id             String   @id @default(cuid())
  foodId         String
  label          String
  amount         Decimal  @db.Decimal(10, 3)
  unit           String
  gramEquivalent Decimal? @db.Decimal(10, 3)
  mlEquivalent   Decimal? @db.Decimal(10, 3)
  isDefault      Boolean  @default(false)
  food           Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

model FoodSource {
  id                String    @id @default(cuid())
  foodId            String
  provider          String
  providerId        String?
  retrievedAt       DateTime
  providerUpdatedAt DateTime?
  url               String?
  confidence        Decimal?  @db.Decimal(4, 3)
  estimated         Boolean   @default(false)
  model             String?
  assumptions       Json?
  metadata          Json?
  food              Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

/// value is NULL when the nutrient is unknown. It is never coerced to zero.
model FoodNutrient {
  foodId      String
  nutrientKey String
  value       Decimal? @db.Decimal(18, 6)
  sourceValue Decimal? @db.Decimal(18, 6)
  sourceUnit  String?
  /**
   * Why a value is absent, or what kind of number it is, when the source says
   * more than "unknown": TRACE, BELOW_LOD, BELOW_LOQ, LOGICAL_ZERO. BLS 4.0
   * distinguishes all four, and flattening them into a null or - far worse -
   * into a zero would misreport the food. A plain measured value has none.
   */
  qualifier   String?
  /**
   * How the source obtained the value, in the source's own vocabulary: BLS
   * data-source categories such as `Analyse`, `Rezeptberechnung` or
   * `Formelberechnung`, or a USDA derivation code. Kept per nutrient because
   * that is the granularity BLS publishes it at.
   */
  origin      String?

  food     Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient NutrientDefinition @relation(fields: [nutrientKey], references: [key], onDelete: Cascade)

  @@id([foodId, nutrientKey])
  @@index([nutrientKey])
}

model Recipe {
  id                       String       @id @default(cuid())
  ownerId                  String
  name                     String
  alternativeName          String?
  description              String?
  servings                 Decimal      @db.Decimal(8, 2)
  yieldWeightG             Decimal?     @db.Decimal(10, 2)
  instructions             String?
  tags                     String[]
  favorite                 Boolean      @default(false)
  sourceType               SourceType   @default(RECIPE)
  status                   RecipeStatus @default(ACTIVE)
  /// The AI import this draft came from, so the review can still name the
  /// ingredients that could not be matched or converted.
  importId                 String?
  /// The publication this recipe was saved from, and who wrote it. The copy is
  /// independent - it reads none of the author's rows - so the attribution has
  /// to be carried here rather than followed through a relation that may go.
  forkedFromPublicationId  String?
  forkedFromAuthorSnapshot String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  import       AiIngestionInput?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  ingredients  RecipeIngredient[]
  diaryEntries DiaryEntry[]
  sources      RecipeSource[]
  publications RecipePublication[]
  forkedFrom   RecipePublication?  @relation("RecipeForkedFrom", fields: [forkedFromPublicationId], references: [id], onDelete: SetNull)

  @@index([ownerId, name])
  @@index([ownerId, status])
  @@index([importId])
  @@index([forkedFromPublicationId])
}

model RecipeSource {
  id          String    @id @default(cuid())
  recipeId    String
  title       String?
  url         String
  provider    String?
  retrievedAt DateTime?
  metadata    Json?
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  recipeId        String
  foodId          String
  amount          Decimal  @db.Decimal(10, 3)
  unit            String
  normalizedGrams Decimal? @db.Decimal(10, 3)
  normalizedMl    Decimal? @db.Decimal(10, 3)
  position        Int      @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Cascade, not the default restrict. The one case where a food a recipe
  /// uses is deleted at all is the account cascade - the prune explicitly
  /// keeps a food a recipe references, and nothing else deletes one - and
  /// there the recipe is going too. Left restricting, deleting an account
  /// failed outright as soon as the user had built a recipe from a food they
  /// had created themselves.
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([foodId])
}

model DiaryDay {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DiaryEntry[]

  @@unique([userId, date])
}

/// nutritionSnapshot freezes the nutrition at logging time so provider updates
/// can never rewrite history.
model DiaryEntry {
  id                 String     @id @default(cuid())
  diaryDayId         String
  meal               MealType
  foodId             String?
  recipeId           String?
  label              String
  quantity           Decimal    @db.Decimal(10, 3)
  unit               String
  normalizedAmount   Decimal?   @db.Decimal(10, 3)
  normalizedUnit     BasisUnit?
  nutritionSnapshot  Json
  provenanceSnapshot Json
  position           Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  diaryDay DiaryDay @relation(fields: [diaryDayId], references: [id], onDelete: Cascade)
  food     Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([diaryDayId, meal])
}

model Favorite {
  userId    String
  foodId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
}

model FoodUsageStats {
  userId     String
  foodId     String
  count      Int        @default(0)
  lastUsedAt DateTime?
  usualMeals MealType[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
  @@index([userId, lastUsedAt])
}

model ExternalFoodCache {
  id                String    @id @default(cuid())
  provider          String
  externalId        String
  barcode           String?
  normalizedName    String
  brand             String?
  locale            Locale?
  retrievedAt       DateTime
  providerUpdatedAt DateTime?
  expiresAt         DateTime
  normalized        Json
  rawSnapshot       Json?

  @@unique([provider, externalId])
  @@index([barcode])
  @@index([normalizedName])
  @@index([expiresAt])
}

/// What a bundled food database import last did, so re-running it is cheap.
///
/// The importer compares the artifact's checksum against the stored one and
/// stops immediately when they match. That is what keeps `db:import:foods`
/// safe to call from a deployment: an unchanged dataset costs one query
/// instead of reconciling 15,000 foods, so ordinary startup stays fast.
model DatasetImport {
  /// `bls`, `usda-foundation`, `usda-sr-legacy`.
  key         String   @id
  version     String
  checksum    String
  recordCount Int      @default(0)
  /// Counts of created/updated/skipped rows and any unmapped source fields.
  stats       Json?
  durationMs  Int?
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchQueryCache {
  id        String   @id @default(cuid())
  provider  String
  queryKey  String
  results   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([provider, queryKey])
  @@index([expiresAt])
}

model ResearchJob {
  id                  String         @id @default(cuid())
  userId              String
  query               String
  language            Locale
  /**
   * URLs the user supplied, already validated against their consent. Stored
   * because the run happens later, in the worker, rather than inline in the
   * request that submitted the form.
   */
  requestedSourceUrls Json?
  status              ResearchStatus @default(REQUESTED)
  model               String?
  assumptions         Json?
  structuredResponse  Json?
  failureReason       String?
  meal                MealType?
  diaryDate           DateTime?      @db.Date
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources    ResearchSource[]
  candidates ResearchCandidate[]

  @@index([userId, createdAt])
}

model ResearchSource {
  id      String      @id @default(cuid())
  jobId   String
  title   String
  url     String
  excerpt String?
  job     ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ResearchCandidate {
  id         String      @id @default(cuid())
  jobId      String
  payload    Json
  confidence Decimal     @db.Decimal(4, 3)
  acceptedAt DateTime?
  job        ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

/// A recipe as it was shared with the other members of this instance.
///
/// Deliberately a snapshot rather than a readable view of the author's private
/// `Recipe`: editing the private recipe must not silently rewrite what other
/// members are reading, deleting it must not break the copies they saved, and
/// publishing must never make the author's private food rows reachable. The
/// same reasoning the diary already applies to `nutritionSnapshot`.
model RecipePublication {
  id                 String            @id @default(cuid())
  authorId           String
  /// The private recipe this was taken from, kept so the author can see that a
  /// recipe is published and withdraw it. `SetNull`, never cascade: deleting
  /// the private recipe leaves the publication and every saved copy standing.
  sourceRecipeId     String?
  /// The author's display name as it read at publication time. A rename must
  /// not silently re-attribute a recipe, and an account that is gone must still
  /// credit someone.
  authorNameSnapshot String
  title              String
  description        String?
  servings           Decimal           @db.Decimal(8, 2)
  yieldWeightG       Decimal?          @db.Decimal(10, 2)
  instructions       String?
  tags               String[]
  locale             Locale?
  /// Per-serving and per-100 g nutrition with its coverage, frozen at
  /// publication time, so the listing never has to read the author's foods.
  nutritionSnapshot  Json
  status             PublicationStatus @default(PUBLISHED)
  publishedAt        DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  author       User                          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sourceRecipe Recipe?                       @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  ingredients  RecipePublicationIngredient[]
  copies       Recipe[]                      @relation("RecipeForkedFrom")

  @@index([status, publishedAt])
  @@index([authorId, publishedAt])
  @@index([sourceRecipeId])
}

enum PublicationStatus {
  PUBLISHED
  WITHDRAWN
}

/// One ingredient of a publication, carrying both what to display and enough
/// provenance for a recipient to find the same food again.
///
/// `foodId` is deliberately absent. A recipe ingredient points at a `Food` that
/// may be the author's own private row, and a publication that referenced it
/// would hand every reader a private record - the one boundary
/// `visibleFoodWhere` exists to hold.
model RecipePublicationIngredient {
  publicationId     String
  position          Int
  displayName       String
  brand             String?
  amount            Decimal    @db.Decimal(10, 3)
  unit              String
  /// The resolved measures, so a copy is weighed exactly as the publication was
  /// rather than re-resolving a household unit against a different food.
  weightG           Decimal    @db.Decimal(10, 3)
  normalizedMl      Decimal?   @db.Decimal(10, 3)
  basisAmount       Decimal    @db.Decimal(10, 3)
  basisUnit         BasisUnit
  /// The food's per-basis nutrition at publication time.
  nutritionSnapshot Json
  /// How a recipient may find the same food: the shared provider row first, its
  /// barcode second. Both may be absent for a food the author created.
  sourceType        SourceType
  externalProvider  String?
  externalId        String?
  barcode           String?
  densityGPerMl     Decimal?   @db.Decimal(10, 5)
  /// Whether a recipient may keep these values permanently. False for a source
  /// whose terms allow caching but not storage (`PersistencePolicy`): such an
  /// ingredient may be re-used while the shared row still exists, but its
  /// numbers are never copied into a permanent private food.
  permanent         Boolean    @default(true)

  publication RecipePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@id([publicationId, position])
  @@index([publicationId])
}

/// Whether a proposed value has been looked at, and what was decided.
enum EnrichmentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One enrichment run's findings for one food, held for a human to approve.
///
/// Enrichment was the only AI path in the app that wrote its results straight
/// into shared data. Every other one - a quick meal, a recipe import, a body
/// scan - produces something a person confirms, which is the "human approves"
/// half of the principle the worker states in `ai-jobs.ts`. This table is that
/// step for nutrition backfill, and doubles as the record of what each run
/// actually asked a source for.
model EnrichmentProposal {
  id             String                 @id @default(cuid())
  foodId         String
  /**
   * The page the values were read from. Null only for the rows the migration
   * reconstructs for values that were applied before this table existed: what
   * they came from is known per food, not per value.
   */
  sourceUrl      String?
  model          String?
  retrievedAt    DateTime
  /**
   * Every nutrient key this run asked the source for, answered or not. Kept so
   * a later run can ask for the keys no run has tried yet, rather than
   * repeating the same window of the catalogue for ever.
   */
  requestedKeys  String[]
  /// A serving weight the source stated, when the food had none.
  servingSizeG   Decimal?               @db.Decimal(10, 2)
  servingStatus  EnrichmentReviewStatus @default(PENDING)
  /// Whether that serving weight is the one currently on the food.
  servingApplied Boolean                @default(false)
  createdAt      DateTime               @default(now())

  food   Food                      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  values EnrichmentProposalValue[]

  @@index([foodId])
  @@index([createdAt])
}

/// One nutrient value a run proposed, and what became of it.
model EnrichmentProposalValue {
  id           String                 @id @default(cuid())
  proposalId   String
  nutrientKey  String
  value        Decimal                @db.Decimal(18, 6)
  status       EnrichmentReviewStatus @default(PENDING)
  /**
   * Whether this value is the one currently stored on the food. A pending row
   * that is already applied is a value written before review existed: approving
   * keeps it, rejecting takes it back out.
   */
  applied      Boolean                @default(false)
  /**
   * Who decided, for the audit line. Deliberately not a foreign key: the
   * decision is worth keeping even once the account that made it is gone.
   */
  reviewedById String?
  reviewedAt   DateTime?

  proposal EnrichmentProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, nutrientKey])
  @@index([status])
}
