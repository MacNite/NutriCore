generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  de
  en
}

enum BasisUnit {
  G
  ML
}

enum SourceType {
  OPEN_FOOD_FACTS
  USDA
  USER
  RECIPE
  AI_RESEARCH
  IMPORTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

enum FoodType {
  PACKAGED
  GENERIC
  RAW
  COOKED
  BEVERAGE
  RECIPE
}

/// An AI-generated recipe is stored as a DRAFT: it is listed with the user's
/// recipes but has no Food entry, so nothing can be logged from it until the
/// user has confirmed it.
enum RecipeStatus {
  DRAFT
  ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
  CUSTOM
}

enum BiologicalSex {
  MALE
  FEMALE
  UNSPECIFIED
}

/// Where a recorded body value came from. Shown as a text badge, never as colour alone.
enum MeasurementSource {
  MANUAL
  BIA
  OTHER_DEVICE
}

/// A cosmetic build for the drawn figure. Chosen by the user, never inferred
/// from their measurements and never used in any calculation: somatotypes are
/// not a diagnosis and carry no predictive meaning here.
enum BodyType {
  ECTOMORPH
  MESOMORPH
  ENDOMORPH
}

/// How the drawn figure is presented. Separate from `biologicalSex`, which is
/// a clinical input to the energy and body-fat formulas.
enum BodyFigure {
  NEUTRAL
  MASCULINE
  FEMININE
}

/// How the body-shape panel draws that figure: as a silhouette with tinted
/// change bands, or as a measure figure with a caliper across every level a
/// tape measure was put around. A display choice over the same numbers.
enum BodyShapeStyle {
  SILHOUETTE
  MEASURE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ResearchStatus {
  REQUESTED
  SEARCHING
  SOURCES_FOUND
  EXTRACTING
  MATCHING_INGREDIENTS
  CALCULATING
  AWAITING_CONFIRMATION
  ACCEPTED
  REJECTED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AiApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  role               UserRole @default(USER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)

  profile           UserProfile?
  sessions          Session[]
  targets           NutritionTarget[]
  weights           WeightEntry[]
  bodyMeasurements  BodyMeasurement[]
  foods             Food[]
  recipes           Recipe[]
  diaryDays         DiaryDay[]
  favorites         Favorite[]
  usage             FoodUsageStats[]
  research          ResearchJob[]
  invitationsSent   UserInvitation[]   @relation("InvitationSender")
  aiJobs            AiJob[]
  aiIngestionInputs AiIngestionInput[]
  activityEntries   ActivityEntry[]
}

model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  name        String?
  role        UserRole  @default(USER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  invitedBy   User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// Singleton SMTP configuration (the row with id = "default"). The password
/// is encrypted with APP_SECRET before it reaches the database.
model MailSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String?
  port              Int      @default(587)
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromEmail         String?
  fromName          String?
  updatedAt         DateTime @updatedAt
}

model AiIngestionInput {
  id              String    @id @default(cuid())
  userId          String
  intent          String
  text            String
  sourceUrl       String?
  /**
   * Transient worker handoff; cleared after extraction or terminal cleanup.
   */
  imageMime       String?
  imageData       Bytes?
  imageExpiresAt  DateTime?
  meal            MealType?
  diaryDate       DateTime? @db.Date
  /**
   * Number of portions described by the submitted text, URL, or photo.
   */
  servings        Decimal   @default(1) @db.Decimal(8, 2)
  logAfterConfirm Boolean   @default(false)
  draft           Json?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiJobs          AiJob[]
  recipes         Recipe[]

  @@index([userId, createdAt])
  @@index([imageExpiresAt])
}

model AiJob {
  id               String            @id @default(cuid())
  userId           String
  entityType       String
  entityId         String
  ingestionInputId String?
  status           AiJobStatus       @default(QUEUED)
  /**
   * Higher runs first. A "Backfill missing nutrition" sweep can queue hundreds
   * of jobs at once, and a strictly chronological queue put every quick meal
   * behind all of them - hours of waiting for a request the user is watching.
   */
  priority         Int               @default(10)
  retryCount       Int               @default(0)
  maxRetries       Int               @default(2)
  model            String?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  /**
   * Machine-readable cause of the last failure; see `AiFailureKind`.
   */
  failureKind      String?
  /**
   * Longest useful diagnostic detail, e.g. the underlying fetch/undici cause.
   */
  errorDetail      String?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingestionInput   AiIngestionInput? @relation(fields: [ingestionInputId], references: [id], onDelete: Cascade)
  proposal         AiProposal?
  attempts         AiJobAttempt[]

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
}

/**
 * One recorded attempt at a job. `AiJob.errorMessage` only ever holds the most
 * recent failure, which hides the pattern that actually explains a job: three
 * different reasons across three retries mean something else than the same
 * reason three times. Kept per attempt so the admin page can show that pattern.
 */
model AiJobAttempt {
  id         String   @id @default(cuid())
  jobId      String
  /**
   * Value of `AiJob.retryCount` when the attempt ran; 0 is the first try.
   */
  attempt    Int
  kind       String
  message    String
  detail     String?
  model      String?
  durationMs Int?
  createdAt  DateTime @default(now())
  job        AiJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attempt])
}

model AiProposal {
  id             String           @id @default(cuid())
  jobId          String           @unique
  approvalStatus AiApprovalStatus @default(PENDING)
  confidence     String
  proposed       Json
  accepted       Json?
  provenance     Json
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  job            AiJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  displayName         String
  language            Locale          @default(de)
  unitPreference      String          @default("metric")
  birthDate           DateTime?       @db.Date
  heightCm            Decimal?        @db.Decimal(6, 2)
  weightKg            Decimal?        @db.Decimal(6, 2)
  biologicalSex       BiologicalSex   @default(UNSPECIFIED)
  activityLevel       ActivityLevel   @default(MODERATE)
  goal                Goal            @default(MAINTAIN)
  targetWeightKg      Decimal?        @db.Decimal(6, 2)
  isPregnant          Boolean         @default(false)
  isBreastfeeding     Boolean         @default(false)
  aiEnabled           Boolean         @default(true)
  researchEnabled     Boolean         @default(false)
  /**
   * Apply an AI meal proposal to the diary without opening the review screen.
   * Defaults on because a queued meal that is never reviewed is a meal that was
   * never logged, and the review screen is only reachable straight after
   * submitting. Everything it logs is still recorded on the proposal and every
   * value still carries its provenance; turn it off to approve each one by hand.
   */
  autoApproveAi       Boolean         @default(true)
  theme               String          @default("system")
  /// Appearance of the body-progress figure. Null until the user picks one.
  bodyType            BodyType?
  bodyFigure          BodyFigure?
  /// How the shape panel draws it. Null until the user picks one.
  bodyShapeStyle      BodyShapeStyle?
  /**
   * Which body-progress visualisations the reader wants. Both default on: the
   * card is the point of the progress page, and anyone who never opens their
   * settings should still see it. Turning one off hides the visualisation only
   * - the underlying measurements stay recorded, exported and editable.
   */
  showBodyComposition Boolean         @default(true)
  showBodyShape       Boolean         @default(true)
  onboardedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Every component of the calorie target is stored, never only the final number.
model NutritionTarget {
  id                 String   @id @default(cuid())
  userId             String
  validFrom          DateTime @default(now())
  bmrKcal            Decimal? @db.Decimal(8, 2)
  activityMultiplier Decimal? @db.Decimal(4, 2)
  tdeeKcal           Decimal? @db.Decimal(8, 2)
  goalAdjustmentKcal Decimal? @db.Decimal(8, 2)
  calculatedKcal     Decimal? @db.Decimal(8, 2)
  overrideKcal       Decimal? @db.Decimal(8, 2)
  proteinG           Decimal? @db.Decimal(8, 2)
  carbohydrateG      Decimal? @db.Decimal(8, 2)
  fatG               Decimal? @db.Decimal(8, 2)
  eligible           Boolean  @default(true)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validFrom])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Decimal  @db.Decimal(6, 2)
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/// One measuring-tape session. Weight is deliberately absent: it lives in
/// `WeightEntry` so the weight chart, the goal line and body progress can never
/// disagree about what someone weighed on a given day.
///
/// Every value is optional. A session where only the waist was measured is a
/// real session, and storing zero for the rest would be a lie about it.
model BodyMeasurement {
  id                String             @id @default(cuid())
  userId            String
  date              DateTime           @db.Date
  neckCm            Decimal?           @db.Decimal(5, 1)
  chestCm           Decimal?           @db.Decimal(5, 1)
  waistCm           Decimal?           @db.Decimal(5, 1)
  hipCm             Decimal?           @db.Decimal(5, 1)
  upperArmLeftCm    Decimal?           @db.Decimal(5, 1)
  upperArmRightCm   Decimal?           @db.Decimal(5, 1)
  thighLeftCm       Decimal?           @db.Decimal(5, 1)
  thighRightCm      Decimal?           @db.Decimal(5, 1)
  calfLeftCm        Decimal?           @db.Decimal(5, 1)
  calfRightCm       Decimal?           @db.Decimal(5, 1)
  bodyFatPct        Decimal?           @db.Decimal(4, 1)
  muscleKg          Decimal?           @db.Decimal(5, 1)
  bodyWaterPct      Decimal?           @db.Decimal(4, 1)
  boneKg            Decimal?           @db.Decimal(4, 1)
  /// Where the composition values came from. Null when none were recorded.
  compositionSource MeasurementSource?
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/// Exercise energy is snapshotted so catalogue and weight changes never rewrite history.
model ActivityEntry {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @db.Date
  activityKey        String
  intensityKey       String
  durationMinutes    Int
  metSnapshot        Decimal  @db.Decimal(5, 2)
  weightKgSnapshot   Decimal? @db.Decimal(6, 2)
  activeKcalSnapshot Decimal? @db.Decimal(10, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Canonical nutrient catalogue. New nutrients are rows, not migrations.
model NutrientDefinition {
  id            String @id @default(cuid())
  key           String @unique
  nameDe        String
  nameEn        String
  canonicalUnit String
  category      String @default("micro")
  sortOrder     Int    @default(1000)

  values FoodNutrient[]
}

model Food {
  id               String     @id @default(cuid())
  ownerId          String?
  name             String
  normalizedName   String
  locale           Locale?
  brand            String?
  barcode          String?
  foodType         FoodType   @default(GENERIC)
  sourceType       SourceType
  externalProvider String?
  externalId       String?
  basisAmount      Decimal    @default(100) @db.Decimal(10, 3)
  basisUnit        BasisUnit
  servingSize      Decimal?   @db.Decimal(10, 3)
  servingUnit      String?
  densityGPerMl    Decimal?   @db.Decimal(10, 5)
  dataConfidence   Decimal?   @db.Decimal(4, 3)
  isEstimated      Boolean    @default(false)
  rawState         String?
  /**
   * When enrichment last ran for this food, whatever it found. Without it the
   * "Backfill missing nutrition" sweep re-queued every food whose gaps could
   * not be filled, on every click, for ever.
   */
  enrichedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  owner             User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  aliases           FoodAlias[]
  servings          FoodServing[]
  sources           FoodSource[]
  nutrients         FoodNutrient[]
  recipeIngredients RecipeIngredient[]
  diaryEntries      DiaryEntry[]
  favorites         Favorite[]
  usage             FoodUsageStats[]

  @@unique([externalProvider, externalId])
  @@index([barcode])
  @@index([normalizedName])
  @@index([ownerId])
}

model FoodAlias {
  id     String  @id @default(cuid())
  foodId String
  name   String
  locale Locale?
  food   Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
  @@index([name])
}

/// A named portion always carries a resolved gram or millilitre quantity.
model FoodServing {
  id             String   @id @default(cuid())
  foodId         String
  label          String
  amount         Decimal  @db.Decimal(10, 3)
  unit           String
  gramEquivalent Decimal? @db.Decimal(10, 3)
  mlEquivalent   Decimal? @db.Decimal(10, 3)
  isDefault      Boolean  @default(false)
  food           Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

model FoodSource {
  id                String    @id @default(cuid())
  foodId            String
  provider          String
  providerId        String?
  retrievedAt       DateTime
  providerUpdatedAt DateTime?
  url               String?
  confidence        Decimal?  @db.Decimal(4, 3)
  estimated         Boolean   @default(false)
  model             String?
  assumptions       Json?
  metadata          Json?
  food              Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}

/// value is NULL when the nutrient is unknown. It is never coerced to zero.
model FoodNutrient {
  foodId      String
  nutrientKey String
  value       Decimal? @db.Decimal(18, 6)
  sourceValue Decimal? @db.Decimal(18, 6)
  sourceUnit  String?

  food     Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient NutrientDefinition @relation(fields: [nutrientKey], references: [key], onDelete: Cascade)

  @@id([foodId, nutrientKey])
  @@index([nutrientKey])
}

model Recipe {
  id              String       @id @default(cuid())
  ownerId         String
  name            String
  alternativeName String?
  description     String?
  servings        Decimal      @db.Decimal(8, 2)
  yieldWeightG    Decimal?     @db.Decimal(10, 2)
  instructions    String?
  tags            String[]
  favorite        Boolean      @default(false)
  sourceType      SourceType   @default(RECIPE)
  status          RecipeStatus @default(ACTIVE)
  /// The AI import this draft came from, so the review can still name the
  /// ingredients that could not be matched or converted.
  importId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  import       AiIngestionInput?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  ingredients  RecipeIngredient[]
  diaryEntries DiaryEntry[]
  sources      RecipeSource[]

  @@index([ownerId, name])
  @@index([ownerId, status])
  @@index([importId])
}

model RecipeSource {
  id          String    @id @default(cuid())
  recipeId    String
  title       String?
  url         String
  provider    String?
  retrievedAt DateTime?
  metadata    Json?
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  recipeId        String
  foodId          String
  amount          Decimal  @db.Decimal(10, 3)
  unit            String
  normalizedGrams Decimal? @db.Decimal(10, 3)
  normalizedMl    Decimal? @db.Decimal(10, 3)
  position        Int      @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food   Food   @relation(fields: [foodId], references: [id])

  @@index([recipeId])
  @@index([foodId])
}

model DiaryDay {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DiaryEntry[]

  @@unique([userId, date])
}

/// nutritionSnapshot freezes the nutrition at logging time so provider updates
/// can never rewrite history.
model DiaryEntry {
  id                 String     @id @default(cuid())
  diaryDayId         String
  meal               MealType
  foodId             String?
  recipeId           String?
  label              String
  quantity           Decimal    @db.Decimal(10, 3)
  unit               String
  normalizedAmount   Decimal?   @db.Decimal(10, 3)
  normalizedUnit     BasisUnit?
  nutritionSnapshot  Json
  provenanceSnapshot Json
  position           Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  diaryDay DiaryDay @relation(fields: [diaryDayId], references: [id], onDelete: Cascade)
  food     Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([diaryDayId, meal])
}

model Favorite {
  userId    String
  foodId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
}

model FoodUsageStats {
  userId     String
  foodId     String
  count      Int        @default(0)
  lastUsedAt DateTime?
  usualMeals MealType[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
  @@index([userId, lastUsedAt])
}

model ExternalFoodCache {
  id                String    @id @default(cuid())
  provider          String
  externalId        String
  barcode           String?
  normalizedName    String
  brand             String?
  locale            Locale?
  retrievedAt       DateTime
  providerUpdatedAt DateTime?
  expiresAt         DateTime
  normalized        Json
  rawSnapshot       Json?

  @@unique([provider, externalId])
  @@index([barcode])
  @@index([normalizedName])
  @@index([expiresAt])
}

model SearchQueryCache {
  id        String   @id @default(cuid())
  provider  String
  queryKey  String
  results   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([provider, queryKey])
  @@index([expiresAt])
}

model ResearchJob {
  id                  String         @id @default(cuid())
  userId              String
  query               String
  language            Locale
  /**
   * URLs the user supplied, already validated against their consent. Stored
   * because the run happens later, in the worker, rather than inline in the
   * request that submitted the form.
   */
  requestedSourceUrls Json?
  status              ResearchStatus @default(REQUESTED)
  model               String?
  assumptions         Json?
  structuredResponse  Json?
  failureReason       String?
  meal                MealType?
  diaryDate           DateTime?      @db.Date
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources    ResearchSource[]
  candidates ResearchCandidate[]

  @@index([userId, createdAt])
}

model ResearchSource {
  id      String      @id @default(cuid())
  jobId   String
  title   String
  url     String
  excerpt String?
  job     ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ResearchCandidate {
  id         String      @id @default(cuid())
  jobId      String
  payload    Json
  confidence Decimal     @db.Decimal(4, 3)
  acceptedAt DateTime?
  job        ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
