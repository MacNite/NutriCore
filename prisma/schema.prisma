generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Locale { de en }
enum BasisUnit { G ML }
enum SourceType { OPEN_FOOD_FACTS USDA USER RECIPE AI_RESEARCH IMPORTED }
enum MealType { BREAKFAST LUNCH DINNER SNACKS }
enum ResearchStatus { REQUESTED SEARCHING SOURCES_FOUND EXTRACTING MATCHING_INGREDIENTS CALCULATING AWAITING_CONFIRMATION ACCEPTED REJECTED FAILED }

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  passwordHash String
  createdAt DateTime @default(now())
  profile UserProfile?
  sessions Session[]
  targets NutritionTarget[]
  weights WeightEntry[]
  foods Food[]
  recipes Recipe[]
  diaryDays DiaryDay[]
  favorites Favorite[]
  usage FoodUsageStats[]
  research ResearchJob[]
}
model Session { id String @id @default(cuid()); tokenHash String @unique; userId String; expiresAt DateTime; user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@index([userId]) }
model UserProfile { id String @id @default(cuid()); userId String @unique; displayName String; language Locale @default(de); unitPreference String @default("metric"); birthDate DateTime?; heightCm Decimal? @db.Decimal(6,2); weightKg Decimal? @db.Decimal(6,2); biologicalSex String?; activityLevel String?; goal String @default("maintain"); targetWeightKg Decimal? @db.Decimal(6,2); isPregnant Boolean @default(false); isBreastfeeding Boolean @default(false); aiEnabled Boolean @default(true); researchEnabled Boolean @default(false); user User @relation(fields:[userId], references:[id], onDelete:Cascade) }
model NutritionTarget { id String @id @default(cuid()); userId String; validFrom DateTime @default(now()); bmrKcal Decimal? @db.Decimal(8,2); activityMultiplier Decimal? @db.Decimal(4,2); tdeeKcal Decimal? @db.Decimal(8,2); goalAdjustmentKcal Decimal? @db.Decimal(8,2); calculatedKcal Decimal? @db.Decimal(8,2); overrideKcal Decimal? @db.Decimal(8,2); proteinG Decimal? @db.Decimal(8,2); carbohydrateG Decimal? @db.Decimal(8,2); fatG Decimal? @db.Decimal(8,2); user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@index([userId,validFrom]) }
model WeightEntry { id String @id @default(cuid()); userId String; date DateTime @db.Date; weightKg Decimal @db.Decimal(6,2); note String?; user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@unique([userId,date]) }

model Food { id String @id @default(cuid()); ownerId String?; name String; normalizedName String; locale Locale?; brand String?; barcode String?; foodType String; sourceType SourceType; externalProvider String?; externalId String?; basisAmount Decimal @default(100) @db.Decimal(10,3); basisUnit BasisUnit; servingSize Decimal? @db.Decimal(10,3); servingUnit String?; densityGPerMl Decimal? @db.Decimal(10,5); dataConfidence Decimal? @db.Decimal(4,3); isEstimated Boolean @default(false); rawState String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; owner User? @relation(fields:[ownerId], references:[id], onDelete:Cascade); aliases FoodAlias[]; servings FoodServing[]; sources FoodSource[]; nutrients FoodNutrient[]; recipeIngredients RecipeIngredient[]; diaryEntries DiaryEntry[]; favorites Favorite[]; usage FoodUsageStats[]; @@index([barcode]); @@index([normalizedName]); @@index([externalProvider,externalId]) }
model FoodAlias { id String @id @default(cuid()); foodId String; name String; locale Locale?; food Food @relation(fields:[foodId], references:[id], onDelete:Cascade); @@index([name]) }
model FoodServing { id String @id @default(cuid()); foodId String; label String; amount Decimal @db.Decimal(10,3); unit String; gramEquivalent Decimal? @db.Decimal(10,3); mlEquivalent Decimal? @db.Decimal(10,3); food Food @relation(fields:[foodId], references:[id], onDelete:Cascade) }
model FoodSource { id String @id @default(cuid()); foodId String; provider String; providerId String?; retrievedAt DateTime; providerUpdatedAt DateTime?; url String?; confidence Decimal? @db.Decimal(4,3); estimated Boolean @default(false); metadata Json?; food Food @relation(fields:[foodId], references:[id], onDelete:Cascade) }
model NutrientDefinition { id String @id @default(cuid()); key String @unique; nameDe String; nameEn String; canonicalUnit String; values FoodNutrient[] }
model FoodNutrient { foodId String; nutrientId String; value Decimal? @db.Decimal(18,6); sourceValue Decimal? @db.Decimal(18,6); sourceUnit String?; food Food @relation(fields:[foodId], references:[id], onDelete:Cascade); nutrient NutrientDefinition @relation(fields:[nutrientId], references:[id]); @@id([foodId,nutrientId]) }

model Recipe { id String @id @default(cuid()); ownerId String; name String; alternativeName String?; description String?; servings Decimal @db.Decimal(8,2); yieldWeightG Decimal? @db.Decimal(10,2); instructions String?; tags String[]; favorite Boolean @default(false); sourceType SourceType @default(RECIPE); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade); ingredients RecipeIngredient[]; diaryEntries DiaryEntry[]; @@index([ownerId,name]) }
model RecipeIngredient { id String @id @default(cuid()); recipeId String; foodId String; amount Decimal @db.Decimal(10,3); unit String; normalizedGrams Decimal? @db.Decimal(10,3); normalizedMl Decimal? @db.Decimal(10,3); recipe Recipe @relation(fields:[recipeId], references:[id], onDelete:Cascade); food Food @relation(fields:[foodId], references:[id]) }
model DiaryDay { id String @id @default(cuid()); userId String; date DateTime @db.Date; user User @relation(fields:[userId], references:[id], onDelete:Cascade); entries DiaryEntry[]; @@unique([userId,date]) }
model DiaryEntry { id String @id @default(cuid()); diaryDayId String; meal MealType; foodId String?; recipeId String?; quantity Decimal @db.Decimal(10,3); unit String; normalizedAmount Decimal? @db.Decimal(10,3); normalizedUnit BasisUnit?; nutritionSnapshot Json; provenanceSnapshot Json; createdAt DateTime @default(now()); diaryDay DiaryDay @relation(fields:[diaryDayId], references:[id], onDelete:Cascade); food Food? @relation(fields:[foodId], references:[id]); recipe Recipe? @relation(fields:[recipeId], references:[id]); @@index([diaryDayId,meal]) }
model Favorite { userId String; foodId String; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete:Cascade); food Food @relation(fields:[foodId], references:[id], onDelete:Cascade); @@id([userId,foodId]) }
model FoodUsageStats { userId String; foodId String; count Int @default(0); lastUsedAt DateTime?; usualMeals MealType[]; user User @relation(fields:[userId], references:[id], onDelete:Cascade); food Food @relation(fields:[foodId], references:[id], onDelete:Cascade); @@id([userId,foodId]) }
model ExternalFoodCache { id String @id @default(cuid()); provider String; externalId String; barcode String?; normalizedName String; locale Locale?; retrievedAt DateTime; providerUpdatedAt DateTime?; expiresAt DateTime; normalized Json; rawSnapshot Json?; @@unique([provider,externalId]); @@index([barcode]); @@index([normalizedName]) }
model ResearchJob { id String @id @default(cuid()); userId String; query String; language Locale; status ResearchStatus @default(REQUESTED); model String?; assumptions Json?; structuredResponse Json?; failureReason String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId], references:[id], onDelete:Cascade); sources ResearchSource[]; candidates ResearchCandidate[]; @@index([userId,createdAt]) }
model ResearchSource { id String @id @default(cuid()); jobId String; title String; url String; excerpt String?; job ResearchJob @relation(fields:[jobId], references:[id], onDelete:Cascade) }
model ResearchCandidate { id String @id @default(cuid()); jobId String; payload Json; confidence Decimal @db.Decimal(4,3); acceptedAt DateTime?; job ResearchJob @relation(fields:[jobId], references:[id], onDelete:Cascade) }
model AuditLog { id String @id @default(cuid()); userId String?; action String; entityType String; entityId String?; metadata Json?; createdAt DateTime @default(now()); @@index([userId,createdAt]) }
