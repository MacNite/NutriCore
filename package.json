{
  "name": "nutricore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "worker": "tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "datasets:convert": "node --max-old-space-size=6144 scripts/convert-food-datasets.mjs",
    "db:import:foods": "tsx scripts/import-food-datasets.ts",
    "website": "node website/build.mjs --check"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "@zxing/browser": "0.1.5",
    "argon2": "0.44.0",
    "html-to-image": "^1.11.13",
    "jose": "6.1.0",
    "next": "^15.5.24",
    "next-intl": "4.3.5",
    "nodemailer": "^7.0.13",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.34.4",
    "tsx": "4.20.5",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.0",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^15.5.24",
    "prisma": "6.15.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
